<?xml version="1.0"?>
<package format="3">
  <name>rover_state</name><version>0.3.0</version>
  <description>Exploration interruption, precise target approach, grasp coordination and motion gating.</description>
  <maintainer email="drr@example.com">drr</maintainer><license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>arm_task_interfaces</depend><depend>rcl_interfaces</depend><depend>rclcpp</depend><depend>rclcpp_action</depend><depend>nav2_msgs</depend>
  <depend>nav_msgs</depend><depend>geometry_msgs</depend><depend>std_msgs</depend><depend>std_srvs</depend>
  <depend>tf2_ros</depend><depend>tf2_geometry_msgs</depend><depend>nlohmann_json</depend>
  <exec_depend>rover_explore</exec_depend>
  <exec_depend>rclpy</exec_depend><exec_depend>sensor_msgs</exec_depend>
  <exec_depend>pose_estimator</exec_depend><exec_depend>yolo_node</exec_depend>
  <exec_depend>launch</exec_depend><exec_depend>launch_xml</exec_depend>
  <exec_depend>livox_ros_driver2</exec_depend><exec_depend>lite_motion_planner</exec_depend>
  <exec_depend>launch_ros</exec_depend><exec_depend>python3-yaml</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>

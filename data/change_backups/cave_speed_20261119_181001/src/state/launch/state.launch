"""Complete automatic mission algorithms; chassis/arm serial drivers run separately."""
import copy
import math
import os
import tempfile

import yaml
from ament_index_python.packages import get_package_share_directory
from launch import LaunchDescription
from launch.actions import DeclareLaunchArgument, EmitEvent, GroupAction, IncludeLaunchDescription, OpaqueFunction, RegisterEventHandler, SetLaunchConfiguration
from launch.events import Shutdown
from launch.conditions import IfCondition, UnlessCondition
from launch.event_handlers import OnProcessExit
from launch.launch_description_sources import PythonLaunchDescriptionSource
from launch.substitutions import LaunchConfiguration
from launch_ros.actions import Node
from launch_ros.parameter_descriptions import ParameterValue
from rover_explore_launch.navigation import navigation_actions


def approach_profile(params):
    params = copy.deepcopy(params)
    controller = params['controller_server']['ros__parameters']
    controller['controller_plugins'] = list(controller['controller_plugins']) + ['ApproachPath']
    controller['ApproachPath'] = dict(
        plugin='nav2_regulated_pure_pursuit_controller::RegulatedPurePursuitController',
        desired_linear_vel=0.10, lookahead_dist=0.35, min_lookahead_dist=0.25, max_lookahead_dist=0.6,
        lookahead_time=1.5, use_velocity_scaled_lookahead_dist=False, transform_tolerance=0.2,
        min_approach_linear_velocity=0.03, approach_velocity_scaling_dist=0.4,
        use_collision_detection=True, max_allowed_time_to_collision_up_to_carrot=1.0,
        use_regulated_linear_velocity_scaling=False, use_cost_regulated_linear_velocity_scaling=False,
        allow_reversing=False, use_rotate_to_heading=True, rotate_to_heading_min_angle=0.6,
        rotate_to_heading_angular_vel=0.35, max_angular_accel=10.0, max_robot_pose_search_dist=2.0)
    # 11-08 run_JX0hKA/lMjK2L: RPP limits each in-place turn command to measured_rate + max_angular_accel / 20 Hz,
    # and /odometry publishes ZERO twist, so the cap never grows: 1.0 -> 0.05, 3.2 -> 0.16 rad/s (the chassis
    # turns ~0.04 rad/s at 0.16). 10.0 -> cap 0.5 = rotate_to_heading_angular_vel; the gate smooths at 1.2 rad/s^2.
    # With 1.0 rad/s^2 that is 0.05 rad/s, below the chassis turn deadband, so the rover never started
    # turning and the command never grew (deadlock -> Failed to make progress). 3.2 -> 0.16 rad/s first step.
    controller['goal_checker_plugins'] = list(controller['goal_checker_plugins']) + ['grasp_goal_checker']
    # In-place turns are progress too (SimpleProgressChecker only counts translation -> every turn > 6 s failed).
    controller['progress_checker'] = dict(plugin='nav2_controller::PoseProgressChecker',
        required_movement_radius=controller['progress_checker'].get('required_movement_radius', 0.08),
        required_movement_angle=0.2,
        movement_time_allowance=controller['progress_checker'].get('movement_time_allowance', 6.0))
    controller['goal_checker_plugins'] = list(controller['goal_checker_plugins']) + ['hint_goal_checker']
    controller['hint_goal_checker'] = dict(plugin='nav2_controller::SimpleGoalChecker',
                                           stateful=False, xy_goal_tolerance=0.15, yaw_goal_tolerance=3.14)
    controller['grasp_goal_checker'] = dict(plugin='nav2_controller::SimpleGoalChecker',
                                          stateful=False, xy_goal_tolerance=0.03, yaw_goal_tolerance=0.10)
    return params


def outdoor_goal_profile(params, config):
    """Entrance and destination use ordinary navigation with their own tolerances."""
    params = copy.deepcopy(params)
    controller = params['controller_server']['ros__parameters']
    for phase, default_xy, default_yaw in (('entry', .10, .10), ('exit', .25, .25)):
        prefix = phase + '_navigation'
        if not config.get(prefix + '.enabled', False):
            continue
        xy = float(config.get(prefix + '.position_tolerance', default_xy))
        yaw = float(config.get(prefix + '.yaw_tolerance', default_yaw))
        if not all(math.isfinite(v) and v > 0 for v in (xy, yaw)):
            raise ValueError(prefix + ' tolerances must be finite and positive')
        if phase == 'exit' and config.get('unload_alignment.enabled', False):
            xy = float(config.get('unload_alignment.goal_tolerance', .08))
            yaw = math.pi  # accept every vehicle heading; the bin point is the unload target
            if not math.isfinite(xy) or xy <= 0:
                raise ValueError('Invalid unload alignment goal tolerance')
        checker = phase + '_goal_checker'
        if checker not in controller['goal_checker_plugins']:
            controller['goal_checker_plugins'] = list(controller['goal_checker_plugins']) + [checker]
        controller[checker] = dict(plugin='nav2_controller::SimpleGoalChecker',
            stateful=False, xy_goal_tolerance=xy, yaw_goal_tolerance=yaw)
    return params


def inflation_profile(params, config):
    params = copy.deepcopy(params)
    outdoor = float(config.get('navigation_inflation.outdoor_radius', .37))
    cave = {}
    for kind in ('global', 'local'):
        inflation = params[kind + '_costmap'][kind + '_costmap']['ros__parameters']['inflation_layer']
        radius = float(inflation['inflation_radius'])
        if not all(math.isfinite(v) and v > 0 for v in (radius, outdoor)):
            raise ValueError('Navigation inflation radii must be finite and positive')
        cave['navigation_inflation.cave_' + kind + '_radius'] = radius
        inflation['inflation_radius'] = outdoor
    return params, cave


def outdoor_speed_profile(params, config):
    params = copy.deepcopy(params)
    speed = float(config.get('navigation_speed.outdoor_max_linear', .30))
    if not math.isfinite(speed) or speed <= 0:
        raise ValueError('Outdoor navigation speed must be finite and positive')
    controller = params['controller_server']['ros__parameters']
    outdoor = copy.deepcopy(controller['FollowPath'])
    outdoor['vx_max'] = speed
    outdoor['wz_max'] = max(float(outdoor['wz_max']), .5)
    outdoor['CorridorCritic']['enabled'] = False
    if config.get('unload_alignment.enabled', False):
        correction = copy.deepcopy(outdoor)
        correction['vx_max'] = float(config.get('unload_alignment.speed', .05))
        correction['vx_std'] = .05
        correction['wz_max'] = .25
        correction['GoalAngleCritic']['enabled'] = False
        controller['UnloadAlignPath'] = correction
        if 'UnloadAlignPath' not in controller['controller_plugins']:
            controller['controller_plugins'] = list(controller['controller_plugins']) + ['UnloadAlignPath']
    controller['OutdoorPath'] = outdoor
    if 'OutdoorPath' not in controller['controller_plugins']:
        controller['controller_plugins'] = list(controller['controller_plugins']) + ['OutdoorPath']
    smoother = params['velocity_smoother']['ros__parameters']
    smoother['max_velocity'][0] = max(float(smoother['max_velocity'][0]), speed)
    smoother['max_velocity'][2] = max(float(smoother['max_velocity'][2]), float(outdoor['wz_max']))
    smoother['min_velocity'][2] = -float(smoother['max_velocity'][2])
    return params


def prepare(context):
    bringup = get_package_share_directory('bringup')
    path = LaunchConfiguration('mission_params').perform(context)
    with open(path, encoding='utf-8') as stream:
        config = yaml.safe_load(stream)['mission_state']['ros__parameters']
    calibrated = config.get('geometry_calibrated', False)
    mount = config.get('arm_mount_xyz_rpy', [])
    if calibrated and (len(mount) != 6 or not all(math.isfinite(float(v)) for v in mount)
                       or not math.isfinite(float(config.get('front_offset_m', -1))) or config.get('front_offset_m', -1) < 0):
        raise ValueError('Confirmed geometry needs front_offset_m >= 0 and six finite arm_mount_xyz_rpy values')
    with open(os.path.join(bringup, 'config', 'nav2_params.yaml'), encoding='utf-8') as stream:
        initial_nav, cave_inflation = inflation_profile(yaml.safe_load(stream), config)
        nav = outdoor_speed_profile(outdoor_goal_profile(approach_profile(initial_nav), config), config)
    directory = tempfile.mkdtemp(prefix='exploration_grasp_')
    nav_path = os.path.join(directory, 'nav2.yaml')
    with open(nav_path, 'w', encoding='utf-8') as stream:
        yaml.safe_dump(nav, stream)
    clock = LaunchConfiguration('use_sim_time')
    clock_param = {'use_sim_time': ParameterValue(clock, value_type=bool)}
    navigation_only = LaunchConfiguration('navigation_only').perform(context).lower() == 'true'
    mission_overrides = {'autostart': True, **cave_inflation}
    if navigation_only:
        mission_overrides.update(cave_navigation_only=True, grasp_enabled=False,
                                 **{'centered_grasp.enabled': False, 'unload.enabled': False})
    mission = Node(package='rover_state', executable='mission_state', name='mission_state',
                   parameters=[path, clock_param, mission_overrides], output='screen')
    gate_max_speed = max(float(config.get('navigation_speed.outdoor_max_linear', .30)),
                         float(nav['controller_server']['ros__parameters']['FollowPath']['vx_max']), .2)
    gate = Node(package='rover_state', executable='mission_motion_gate', name='mission_motion_gate',
                parameters=[clock_param, {'require_arm_ready': not navigation_only,
                                             'max_linear_speed': gate_max_speed,
                                             'linear_acceleration': float(config.get('centered_grasp.deceleration', .4))}], output='screen')

    def stopped(event, ctx):
        return [] if ctx.is_shutdown else [EmitEvent(event=Shutdown(reason='Mission coordinator or velocity gate exited'))]

    actions = [
        GroupAction([
            SetLaunchConfiguration('use_sim_time', clock),
            SetLaunchConfiguration('managed_mode', 'true'),
            SetLaunchConfiguration('cmd_vel_output', '/mission/nav_cmd_vel'),
            SetLaunchConfiguration('nav_params_file', nav_path),
            SetLaunchConfiguration('cave_mode', config.get('exploration_mode',
                'true' if config.get('exit_navigation.enabled', False) else 'auto')),
            *navigation_actions(),
        ]),
        RegisterEventHandler(OnProcessExit(target_action=mission, on_exit=stopped)),
        RegisterEventHandler(OnProcessExit(target_action=gate, on_exit=stopped)),
        gate, mission,
    ]
    if calibrated:
        x, y, z, roll, pitch, yaw = [str(float(v)) for v in mount]
        actions.append(Node(package='tf2_ros', executable='static_transform_publisher',
                            name='mission_arm_mount', parameters=[clock_param],
                            arguments=['--x', x, '--y', y, '--z', z, '--roll', roll, '--pitch', pitch,
                                       '--yaw', yaw, '--frame-id', config.get('base_frame', 'base_frame'),
                                       '--child-frame-id', config.get('arm_frame', 'base_link')]))
    return actions


def prepare_arm(context):
    if LaunchConfiguration('navigation_only').perform(context).lower() == 'true':
        return []
    with open(LaunchConfiguration('mission_params').perform(context), encoding='utf-8') as stream:
        config = yaml.safe_load(stream)['mission_state']['ros__parameters']
    executor = Node(package='rover_state', executable='standalone_grasp_executor.py',
                 name='standalone_grasp_executor', output='screen',
                 sigterm_timeout='70', sigkill_timeout='5',
                 parameters=[{'model_path': ParameterValue(LaunchConfiguration('model_path'), value_type=str),
                              'target_class': LaunchConfiguration('target_class'),
                              'target_max_range': float(config.get('perception.max_target_range', 1.5)),
                              'folded_joint_tolerance': float(config.get('arm_folded_joint_tolerance', 0.15)),
                              'precise_near_x': float(config.get('front_offset_m', .30))-float(config['arm_mount_xyz_rpy'][0])+float(config.get('grasp_region_near_gap_m', .13)),
                              'precise_far_x': float(config.get('front_offset_m', .30))-float(config['arm_mount_xyz_rpy'][0])+min(float(config.get('grasp_region_far_gap_m', .40)),float(config.get('centered_grasp.stop_forward_distance', .25))+.02),
                              'grasp_timeout': min(90., max(1., float(config.get('grasp_timeout', 180.))-80.))}])

    def exited(event, ctx):
        return [] if ctx.is_shutdown else [EmitEvent(event=Shutdown(reason='Standalone grasp executor exited'))]
    return [executor, RegisterEventHandler(OnProcessExit(target_action=executor, on_exit=exited))]



def generate_launch_description():
    return LaunchDescription([
        DeclareLaunchArgument('navigation_only', default_value='false'),
        DeclareLaunchArgument('start_sensors', default_value='true'),
        DeclareLaunchArgument('use_sim_time', default_value='false'),
        DeclareLaunchArgument('mission_params', default_value=os.path.join(
            get_package_share_directory('rover_state'), 'config', 'mission.yaml')),
        DeclareLaunchArgument('model_path', default_value=''),
        DeclareLaunchArgument('target_class', default_value='blue_block'),
        DeclareLaunchArgument('navigation_sensor_frame', default_value='camera_color_optical_frame'),
        GroupAction([IncludeLaunchDescription(PythonLaunchDescriptionSource(os.path.join(
            get_package_share_directory('livox_ros_driver2'), 'launch', 'msg_MID360_launch.py')),
            condition=IfCondition(LaunchConfiguration('start_sensors')))]),
        GroupAction([IncludeLaunchDescription(PythonLaunchDescriptionSource(os.path.join(
            get_package_share_directory('pose_estimator'), 'launch', 'camera_switch.launch.py')),
            condition=IfCondition(LaunchConfiguration('start_sensors')))]),
        GroupAction([OpaqueFunction(function=prepare_arm)]),
        GroupAction([OpaqueFunction(function=prepare)]),
    ])

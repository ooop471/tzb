    # ------------------------------------------------------------------ status topic
    def _init_status_state(self, model_path):
        self._stat_lock = threading.Lock()
        self._status_pub_lock = threading.Lock()
        self._status_model_path = str(model_path)
        self._model_failed = False
        self._model_ready = False
        self._model_names = {}
        self._images_received = 0
        self._first_image_mono = None
        self._last_image_mono = None
        self._last_inference_done_mono = None
        self._wait_since_mono = None       # recv time of the frame sitting in the slot (None = slot empty)
        self._busy_since_mono = None       # when the worker picked up the frame it is processing now
        self._inferences = 0
        self._inference_errors = 0
        self._convert_errors = 0
        self._worker_loop_errors = 0
        self._last_error = ''
        self._last_outcome = 'none'
        self._raw_last = 0
        self._target_last = 0
        self._max_target_conf_last = 0.0
        self._published_last = False
        self._published = 0
        self._last_state = None
        self._worker_thread = None
        self._telemetry_patch_applied, self._telemetry_patch_detail = _TELEMETRY_PATCH
        if not self._telemetry_patch_applied:
            # once per process (node is created once): the shutdown hang protection is degraded
            self.get_logger().warn(
                'OpenVINO telemetry opt-out patch NOT applied (' + self._telemetry_patch_detail +
                '); exit relies on child reaping only. Supported opt-out: opt_in_out --opt_out')

    def _compute_status(self) -> dict:
        now = time.monotonic()
        with self._stat_lock:
            last_img = self._last_image_mono
            done = self._last_inference_done_mono
            # stall = the oldest unfinished work (frame waiting in the slot, or frame being processed) is old
            unfinished = [t for t in (self._wait_since_mono, self._busy_since_mono) if t is not None]
            lag = (now - min(unfinished)) if unfinished else 0.0
            img_age = (now - last_img) if last_img is not None else None
            state = _logic.classify_state(
                model_failed=self._model_failed, model_ready=self._model_ready,
                images_received=self._images_received, last_image_age_s=img_age,
                inference_lag_s=lag, last_outcome=self._last_outcome,
                raw_detections_last=self._raw_last, target_detections_last=self._target_last,
                published_last=self._published_last)
            return {
                'state': state,
                'stamp': round(self.get_clock().now().nanoseconds / 1e9, 3),
                'model_path': self._status_model_path,
                'model_names': {str(k): v for k, v in self._model_names.items()},
                'target_class': self.target_class,              # legacy single-class override (may be '')
                'target_class_valid': bool(self._class_priority_valid),
                'target_classes': list(self._class_priority),   # priority order, normalised
                'ignored_classes': sorted(self._ignored),
                'selected_class': self._selected_class_last,
                'images_received': self._images_received,
                'last_image_age_s': None if img_age is None else round(img_age, 2),
                'inferences': self._inferences,
                'last_inference_age_s': None if done is None else round(now - done, 2),
                'inference_errors': self._inference_errors,
                'convert_errors': self._convert_errors,
                'worker_loop_errors': self._worker_loop_errors,
                'telemetry_patch_applied': bool(self._telemetry_patch_applied),
                'telemetry_patch_detail': self._telemetry_patch_detail,
                'worker_alive': bool(self._worker_thread is not None and self._worker_thread.is_alive()),
                'last_error': self._last_error,
                'raw_detections_last': self._raw_last,
                'target_detections_last': self._target_last,
                'max_target_conf_last': round(self._max_target_conf_last, 4),
                'publish_conf_threshold': self.publish_conf_threshold,
                'gate_open': bool(self.publish_gate_open),
                'published': self._published,
            }

    def _publish_status(self, force: bool = False):
        """Publish on state transition (always) and when force=True (1 Hz thread / explicit)."""
        d = self._compute_status()
        with self._status_pub_lock:
            changed = d['state'] != self._last_state
            if not (force or changed):
                return
            if changed:
                old, self._last_state = self._last_state, d['state']
                self.get_logger().info(f'[GRASP][detection][STATE] {old} -> {d["state"]}')
            self.status_publisher.publish(String(data=json.dumps(d, ensure_ascii=False)))

    def _status_loop(self):
        while not self._status_stop.wait(self.status_period_sec):
            try:
                self._publish_status(force=True)
            except Exception:
                pass        # context may be shutting down

    def _record_failure(self, kind: str, exc: BaseException):
        with self._stat_lock:
            if kind == 'convert':
                self._convert_errors += 1
                self._last_outcome = 'convert_error'
            else:
                self._inference_errors += 1
                self._last_outcome = 'inference_error'
            self._last_error = f'{kind}: {type(exc).__name__}: {exc}'[:400]

    def _record_success(self, raw_n, target_n, max_target_conf, published):
        with self._stat_lock:
            self._inferences += 1
            self._last_inference_done_mono = time.monotonic()
            self._last_outcome = 'ok'
            self._raw_last = raw_n
            self._target_last = target_n
            self._max_target_conf_last = max_target_conf
            self._published_last = bool(published)
            if published:
                self._published += 1
    

    def _apply_compute_profile(self):
        """Limit YOLO/OpenVINO CPU usage according to platform profile."""
        threads = self.yolo_threads_nuc if self.NUC else self.yolo_threads_default
        threads = max(1, int(threads))
        os.environ['NUC'] = 'true' if self.NUC else 'false'
        os.environ['YOLO_COMPUTE_PROFILE'] = 'nuc' if self.NUC else 'jiaolong16q'
        os.environ['OV_CPU_THREADS_NUM'] = str(threads)
        os.environ['OPENVINO_CPU_THREADS_NUM'] = str(threads)
        os.environ.setdefault('OMP_NUM_THREADS', str(threads))
        os.environ.setdefault('OPENBLAS_NUM_THREADS', str(threads))
        os.environ.setdefault('MKL_NUM_THREADS', str(threads))
        os.environ.setdefault('NUMEXPR_NUM_THREADS', str(threads))
        profile = 'NUC12 i7 12C/20T' if self.NUC else '机械革命蛟龙16Q 8C/16T'
        self.get_logger().info(f'YOLO compute profile: {profile}, OpenVINO/OMP threads≈{threads}')

    def _stable_haomu_area(self, det, slot: int) -> float:
        """Return history-averaged area for ranking to suppress one-frame box size spikes."""
        area = max(1.0, float(det.width) * float(det.height))
        hist = self._haomu_area_histories[int(slot)]
        if not self.bbox_area_smoothing_enable:
            hist.append(area)
            return area

        if len(hist) >= self.bbox_area_min_history:
            prev_mean = float(np.mean(hist))
            jump_ratio = abs(area - prev_mean) / max(prev_mean, 1.0)
            if jump_ratio > self.bbox_area_jump_ratio:
                now = time.monotonic()
                if now - self._last_area_jump_log_mono > 0.8:
                    self._last_area_jump_log_mono = now
                    self.get_logger().warn(
                        f'haomu bbox area spike suppressed: slot={slot} area={area:.0f} '
                        f'mean={prev_mean:.0f} jump={jump_ratio:.2f}'
                    )
                return prev_mean

        hist.append(area)
        return float(np.mean(hist))


    @staticmethod
    def _target_iou(det, box):
        """IoU between a Detection and a stored (x, y, w, h) box."""
        ax1 = float(det.x)
        ay1 = float(det.y)
        ax2 = ax1 + float(det.width)
        ay2 = ay1 + float(det.height)
        bx1, by1, bw, bh = [float(v) for v in box]
        bx2 = bx1 + bw
        by2 = by1 + bh
        ix1 = max(ax1, bx1)
        iy1 = max(ay1, by1)
        ix2 = min(ax2, bx2)
        iy2 = min(ay2, by2)
        iw = max(0.0, ix2 - ix1)
        ih = max(0.0, iy2 - iy1)
        inter = iw * ih
        area_a = max(0.0, ax2 - ax1) * max(0.0, ay2 - ay1)
        area_b = max(0.0, bx2 - bx1) * max(0.0, by2 - by1)
        union = area_a + area_b - inter
        return inter / union if union > 1.0e-9 else 0.0

    @staticmethod
    def _target_center_distance(det, box):
        cx = float(det.x) + 0.5 * float(det.width)
        cy = float(det.y) + 0.5 * float(det.height)
        bx, by, bw, bh = [float(v) for v in box]
        bcx = bx + 0.5 * bw
        bcy = by + 0.5 * bh
        dx = cx - bcx
        dy = cy - bcy
        return (dx * dx + dy * dy) ** 0.5

    def _update_target_lock(self, det, class_norm, now=None):
        self._locked_bbox = (
            float(det.x), float(det.y), float(det.width), float(det.height))
        self._locked_class = class_norm
        self._locked_stamp = time.monotonic() if now is None else now


    def _select_within_class(self, detections: list, class_norm: str):
        """Choose one detection among boxes of a single (already filtered) class.

        1. If a target is already locked, keep the box nearest to the previous
           selection (IoU/center hysteresis) while it is still present.  This
           stops two similar blocks from alternating every frame.
        2. Only one box: select it.
        3. multi_target_selection == 'confidence': highest confidence.
        4. legacy 'area_left_right': stable area top-2, then left/right.
        """
        if not detections:
            return None
        now = time.monotonic()

        if (self.target_lock_enable and self._locked_bbox is not None
                and class_norm == self._locked_class
                and now - self._locked_stamp <= self.target_lock_timeout_sec):
            best = max(
                detections,
                key=lambda det: self._target_iou(det, self._locked_bbox))
            best_iou = self._target_iou(best, self._locked_bbox)
            best_center = self._target_center_distance(best, self._locked_bbox)
            if (best_iou >= self.target_lock_min_iou
                    or best_center <= self.target_lock_max_center_px):
                self._stable_haomu_area(best, 0)
                self._update_target_lock(best, class_norm, now)
                return best

        if len(detections) == 1:
            self._stable_haomu_area(detections[0], 0)
            self._update_target_lock(detections[0], class_norm, now)
            return detections[0]

        if self.multi_target_selection != 'area_left_right':
            selected = detections[_logic.pick_target_index(
                [(float(d.confidence), d.x, d.y, d.width, d.height) for d in detections],
                self.multi_target_selection)]
            self._update_target_lock(selected, class_norm, now)
            return selected

        by_x = sorted(detections, key=lambda det: float(det.x) + 0.5 * float(det.width))
        stable_area = {}
        for slot, det in enumerate(by_x):
            stable_area[id(det)] = self._stable_haomu_area(det, slot)

        top2 = sorted(
            detections,
            key=lambda det: stable_area.get(id(det), float(det.width) * float(det.height)),
            reverse=True,
        )[:2]

        choose_right = 1 if int(self.left_or_right) == 1 else 0
        selected = sorted(
            top2,
            key=lambda det: float(det.x) + 0.5 * float(det.width),
        )[-1 if choose_right else 0]
        self._update_target_lock(selected, class_norm, now)
        return selected

    def _select_target(self, detections: list):
        """优先级选择单个目标：先按类别优先级，再按类内规则。

        Returns ``(class_norm, detection)``; ``(None, None)`` when no allowed class is present.
        """
        class_norm, group = _logic.priority_class(detections, self._class_priority, self._ignored)
        if class_norm is None:
            return None, None
        return class_norm, self._select_within_class(group, class_norm)

    def _load_model(self, model_path: str, device: str) -> YOLO:
        """
        仅加载 OpenVINO 格式模型目录（不读取 .pt，不做导出）
        """
        model_path = Path(model_path)

        if not model_path.exists():
            self.get_logger().error(f'OpenVINO model path not found: {model_path}')
            raise FileNotFoundError(f'OpenVINO model path not found: {model_path}')

        def _prepare_openvino_dir_alias(src_dir: Path) -> Path | None:
            """为不符合 *_openvino_model 命名的目录创建兼容别名目录。"""
            if not src_dir.is_dir():
                return None

            xml_files_local = sorted(src_dir.glob('*.xml'))
            bin_files_local = sorted(src_dir.glob('*.bin'))
            if not xml_files_local or not bin_files_local:
                return None

            if src_dir.name.endswith('_openvino_model'):
                return src_dir

            xml_stem = xml_files_local[0].stem
            alias_root = Path(tempfile.gettempdir()) / 'yolo_node_openvino_alias'
            alias_root.mkdir(parents=True, exist_ok=True)
            alias_dir = alias_root / f'{xml_stem}_openvino_model'

            if alias_dir.exists():
                try:
                    if alias_dir.is_symlink() or alias_dir.is_file():
                        alias_dir.unlink()
                    elif alias_dir.is_dir():
                        shutil.rmtree(alias_dir)
                except Exception:
                    pass

            # 优先软链接，失败则复制
            try:
                alias_dir.symlink_to(src_dir, target_is_directory=True)
                self.get_logger().info(f'Created OpenVINO alias symlink: {alias_dir} -> {src_dir}')
            except Exception:
                shutil.copytree(src_dir, alias_dir)
                self.get_logger().info(f'Created OpenVINO alias copy: {alias_dir} (from {src_dir})')

            return alias_dir

        # Read the exported task so detection models are not forced through
        # the segmentation code path.
        model_task = 'segment'
        metadata_path = model_path / 'metadata.yaml' if model_path.is_dir() else None
        if metadata_path and metadata_path.exists():
            try:
                metadata = yaml.safe_load(metadata_path.read_text(encoding='utf-8')) or {}
                candidate_task = str(metadata.get('task', model_task)).strip().lower()
                if candidate_task in ('detect', 'segment'):
                    model_task = candidate_task
            except Exception as exc:
                self.get_logger().warning(
                    f'Unable to read model metadata from {metadata_path}: {exc}')

        # 兼容不同 Ultralytics 版本：有的支持目录，有的更偏向 xml
        candidates: list[Path] = [model_path]
        alias_dir = _prepare_openvino_dir_alias(model_path)
        if alias_dir is not None and alias_dir != model_path:
            candidates.insert(0, alias_dir)
        xml_files = sorted(model_path.glob('*.xml')) if model_path.is_dir() else []
        candidates.extend(xml_files)

        last_error: Exception | None = None
        for candidate in candidates:
            try:
                self.get_logger().info(f'Trying OpenVINO model: {candidate}')
                loaded = YOLO(str(candidate), task=model_task)
                # 提前触发后端初始化，尽早暴露加载问题
                dummy = np.zeros((640, 640, 3), dtype=np.uint8)
                _ = loaded.predict(source=dummy, device=device, verbose=False)
                return loaded
            except Exception as e:
                last_error = e
                self.get_logger().warning(f'Failed to load OpenVINO model from {candidate}: {e}')

        raise RuntimeError(
            f'Unable to load OpenVINO model from {model_path}. Last error: {last_error}'
        )
    
    def image_callback(self, msg: Image):
        """
        图像回调函数 - 仅缓存最新图像，实际推理在后台线程执行
        """
        now = time.monotonic()
        with self._stat_lock:
            self._images_received += 1
            self._last_image_mono = now
            if self._first_image_mono is None:
                self._first_image_mono = now
            if self._wait_since_mono is None:
                self._wait_since_mono = now
        with self._image_cv:
            self._latest_image_item = (msg, now)
            self._image_cv.notify()

    def _inference_worker(self):
        while self._worker_running:
            try:
                with self._image_cv:
                    while self._worker_running and self._latest_image_item is None:
                        self._image_cv.wait(timeout=0.1)
                    if not self._worker_running:
                        return
                    item = self._latest_image_item
                    self._latest_image_item = None
                    with self._stat_lock:
                        self._wait_since_mono = None
                        self._busy_since_mono = time.monotonic() if item is not None else None

                if item is None:
                    continue
                msg, recv_mono = item
                try:
                    self._process_image(msg, recv_mono)
                finally:
                    with self._stat_lock:
                        self._busy_since_mono = None
                self._publish_status()          # state transitions only
            except Exception as e:
                # never let an unexpected exception silently kill the worker thread
                with self._stat_lock:
                    self._worker_loop_errors += 1
                    self._last_error = f'worker loop: {type(e).__name__}: {e}'[:400]
                try:
                    self.get_logger().error(f'inference worker loop error (continuing): {e}\n{traceback.format_exc()}')
                except Exception:
                    pass
                time.sleep(0.2)

    def _process_image(self, msg: Image, recv_mono: float = 0.0):
        """
        图像回调函数 - 处理接收到的 RGB 图像
        """
        try:
            t_total0 = time.monotonic()
            t_convert0 = time.monotonic()
            queue_delay_ms = (t_total0 - recv_mono) * 1000.0 if recv_mono > 0.0 else 0.0
            # 将 ROS Image 消息转换为 OpenCV 格式
            try:
                if self._cv_bridge_ok:
                    try:
                        cv_image = self.bridge.imgmsg_to_cv2(msg, desired_encoding='bgr8')
                    except Exception as e:
                        self._cv_bridge_ok = False
                        self.get_logger().error(
                            f'cv_bridge failed ({e}); falling back to raw conversion'
                        )
                        cv_image = _image_msg_to_bgr(msg)
                else:
                    cv_image = _image_msg_to_bgr(msg)
            except Exception as e:
                self._record_failure('convert', e)
                self.get_logger().error(f'Image conversion failed: {e}', throttle_duration_sec=5.0)
                return

            convert_ms = (time.monotonic() - t_convert0) * 1000.0

            # 运行 YOLO 推理
            t_infer0 = time.monotonic()
            try:
                results = self.model.predict(
                    source=cv_image,
                    conf=self.conf_threshold,
                    iou=self.iou_threshold,
                    device=self.device,
                    verbose=False
                )
            except Exception as e:
                self._record_failure('inference', e)
                self.get_logger().error(f'Inference failed: {e}', throttle_duration_sec=5.0)
                return
            infer_ms = (time.monotonic() - t_infer0) * 1000.0
            
            # 创建检测结果消息
            detection_array_msg = self.DetectionArray()
            detection_array_msg.header = msg.header
            max_confidence = 0.0
            
            t_post0 = time.monotonic()

            # 解析检测结果
            for result in results:
                boxes = result.boxes
                if boxes is not None and len(boxes) > 0:
                    for i in range(len(boxes)):
                        detection_msg = self.Detection()
                        
                        # 边界框坐标 (xyxy 格式转为 xywh)
                        xyxy = boxes.xyxy[i].cpu().numpy()
                        detection_msg.x = float(xyxy[0])
                        detection_msg.y = float(xyxy[1])
                        detection_msg.width = float(xyxy[2] - xyxy[0])
                        detection_msg.height = float(xyxy[3] - xyxy[1])
                        
                        # 置信度
                        confidence = float(boxes.conf[i].cpu().numpy())
                        detection_msg.confidence = confidence
                        if confidence > max_confidence:
                            max_confidence = confidence
                        
                        # 类别 ID 和名称
                        class_id = int(boxes.cls[i].cpu().numpy())
                        detection_msg.class_id = class_id
                        detection_msg.class_name = self.model.names.get(class_id, f'class_{class_id}')
                        
                        detection_array_msg.detections.append(detection_msg)
            
            # 优先级选择：只发布“当前最高优先级类别”的那一个目标；
            # 下游不会再看到混合类别（d 已在 _select_target 中永久排除）。
            all_detections = detection_array_msg.detections
            raw_n = len(all_detections)
            selected_class, selected_det = self._select_target(all_detections)
            self._selected_class_last = selected_class or ''
            if selected_det is not None:
                detection_array_msg.detections = [selected_det]
                target_n = 1
                max_confidence = float(selected_det.confidence)
            else:
                detection_array_msg.detections = []
                target_n = 0
                max_confidence = 0.0
            if not self._class_priority_valid:
                max_confidence = 0.0      # no usable class: never publish

            # 发布门控：仅当 max_confidence 持续超过阈值指定时长后才允许发布
            now_sec = self.get_clock().now().nanoseconds / 1e9
            should_publish = False

            if max_confidence > self.publish_conf_threshold:
                if self.high_conf_start_time_sec is None:
                    self.high_conf_start_time_sec = now_sec
                    self.get_logger().info(
                        f'[GRASP][detection][WAIT_HOLD] max_conf={max_confidence:.3f}',
                        throttle_duration_sec=5.0
                    )

                hold_elapsed = now_sec - self.high_conf_start_time_sec
                if hold_elapsed >= self.publish_hold_seconds:
                    should_publish = True
                    if not self.publish_gate_open:
                        self.publish_gate_open = True
                        self.get_logger().info(
                            f'Publish gate opened: confidence>{self.publish_conf_threshold} '
                            f'held for {hold_elapsed:.3f}s. Publishing enabled.',
                            throttle_duration_sec=5.0
                        )
            else:
                if self.high_conf_start_time_sec is not None or self.publish_gate_open:
                    self.get_logger().info(
                        f'Publish gate reset (max_conf={max_confidence:.3f} <= '
                        f'{self.publish_conf_threshold}). Publishing paused.',
                        throttle_duration_sec=5.0
                    )
                self.high_conf_start_time_sec = None
                self.publish_gate_open = False

            post_ms = (time.monotonic() - t_post0) * 1000.0

            # 'no empty message' contract: only publish when at least one target-class box passed the gate
            should_publish = should_publish and target_n > 0 and self._class_priority_valid
            self._record_success(raw_n, target_n, max_confidence, should_publish)

            if should_publish:
                # 发布检测结果
                self.detection_publisher.publish(detection_array_msg)

                # 发布带标注的图像
                if self.annotated_image_publisher.get_subscription_count() > 0:
                    annotated_frame = cv_image.copy()
                    for det in detection_array_msg.detections:
                        x1 = int(round(det.x))
                        y1 = int(round(det.y))
                        x2 = int(round(det.x + det.width))
                        y2 = int(round(det.y + det.height))
                        cv2.rectangle(annotated_frame, (x1, y1), (x2, y2), (0, 255, 0), 2)
                        label = f"{det.class_name} {det.confidence:.2f}"
                        cv2.putText(
                            annotated_frame,
                            label,
                            (x1, max(0, y1 - 8)),
                            cv2.FONT_HERSHEY_SIMPLEX,
                            0.5,
                            (0, 255, 0),
                            1,
                            cv2.LINE_AA,
                        )
                    if self._cv_bridge_ok:
                        annotated_msg = self.bridge.cv2_to_imgmsg(
                            annotated_frame, encoding='bgr8'
                        )
                        annotated_msg.header = msg.header
                    else:
                        annotated_msg = _bgr_to_image_msg(annotated_frame, msg.header)
                    self.annotated_image_publisher.publish(annotated_msg)
            
            # 终端计时日志
            total_ms = (time.monotonic() - t_total0) * 1000.0
            self._log_timing(
                queue_delay_ms=queue_delay_ms,
                convert_ms=convert_ms,
                infer_ms=infer_ms,
                post_ms=post_ms,
                total_ms=total_ms,
                num_detections=len(detection_array_msg.detections),
                max_confidence=max_confidence,
                should_publish=should_publish)

            # 日志输出检测数量
            num_detections = len(detection_array_msg.detections)
            if num_detections > 0:
                self.get_logger().debug(f'Detected {num_detections} objects')
                
        except Exception as e:
            self.get_logger().error(f'Error processing image: {str(e)}')
            self.get_logger().error(traceback.format_exc())

    def _log_timing(self, queue_delay_ms, convert_ms, infer_ms, post_ms, total_ms,
                    num_detections, max_confidence, should_publish):
        if not self.timing_log_enable:
            return
        now = time.monotonic()
        if now - self._last_timing_log_mono < self.timing_log_throttle_sec:
            return
        self._last_timing_log_mono = now
        self.get_logger().info(
            f"[GRASP][detection][STATUS] total={total_ms:.0f}ms | queue={queue_delay_ms:.0f} "
            f"convert={convert_ms:.0f} infer={infer_ms:.0f} post={post_ms:.0f}ms | "
            f"det={num_detections} max_conf={max_confidence:.2f} publish={should_publish}",
            throttle_duration_sec=5.0)

    def destroy_node(self):
        if hasattr(self, '_status_stop'):
            self._status_stop.set()
        self._worker_running = False
        with self._image_cv:
            self._image_cv.notify_all()
        if hasattr(self, '_worker_thread'):
            self._worker_thread.join(timeout=1.0)
        return super().destroy_node()


def main(args=None):
    rclpy.init(args=args)
    
    node = YoloDetectorNode()
    
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        # rclpy's own SIGINT handler may already have shut the context down; calling shutdown() again
        # raised RCLError and made the process exit with code 1 on every Ctrl-C / launch SIGINT.
        if rclpy.ok():
            rclpy.shutdown()
        _reap_helper_processes()


if __name__ == '__main__':
    main()
